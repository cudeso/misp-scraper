[Unit]
Description=Start MISP Scraper Flask server
After=misp-workers.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/misp-scraper/
Environment=PATH=/home/ubuntu/misp-scraper/venv/bin
ExecStart=/home/ubuntu/misp-scraper/venv/bin/python /var/www/MISP/misp-custom/misp-scraper/misp-scraper.py flask
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
