# Copy to docker/.env

# Used by the redis service and read back by scraper.py as redis_password.
REDIS_PASSWORD=

# Seconds between cron runs.
CRON_INTERVAL=3600

# Interface the redis port binds to. Move to 0.0.0.0 only when zsazsa runs on
# another host, and firewall it: the password is the only protection.
REDIS_BIND=127.0.0.1
